# ====================================================================
# STUDENT INFORMATION MANAGEMENT SYSTEM (SIMS)
# Environment Configuration Template
# ====================================================================
#
# Instructions:
# 1. Duplicate this file and name the copy ".env.local"
# 2. In your Supabase dashboard (https://supabase.com/dashboard/project/_/settings/api):
#    - Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL
#    - Copy "anon / public" API key into NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3. For Vercel production deployment:
#    Add these same environment variables in your Vercel Project Settings -> Environment Variables.

# Supabase API URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable Key (Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional: Server-only Service Role Key (Keep private! Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-placeholder
